        {
          "name": "Растительное масло",
          "amount": 50,
          "unit": "мл"
        },
        {
          "name": "Анисовая водка",
          "amount": 50,
          "unit": "мл"
        },
        {
          "name": "Сельдерей",
          "amount": 2,
          "unit": "стебля"
