      "mealType": "main",
      "category": {
        "slug": "",
        "name": ""
      },
      "cuisine": {
        "slug": "",
        "name": "авторская кухня"
      },
      "portions": 4,
      "ingredients": [
        {
          "name": "говядина филе",
          "amount": 500,
          "unit": "г"
        },
        {
          "name": "лук репчатый",
          "amount": 1,
          "unit": "шт."
