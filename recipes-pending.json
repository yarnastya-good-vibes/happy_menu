      "title": "Вареники из трески с лимонной цедрой и укропом",
      "image": "https://e3.edimdoma.ru/data/recipes/0015/5023/155023-ed4_wide.jpg?1773772756",
      "time": 90,
      "difficulty": "Средне",
      "diet": "meat",
      "meatCategory": "no-red-meat",
      "mealType": "main",
      "category": {
        "slug": "",
