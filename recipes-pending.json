      "title": "Фаршированный кальмар",
      "image": "https://e3.edimdoma.ru/data/recipes/0015/5152/155152-ed4_wide.jpg?1779869285",
      "time": 20,
      "difficulty": "Легко",
      "diet": "meat",
      "meatCategory": "no-red-meat",
      "mealType": "main",
      "category": {
        "slug": "",
