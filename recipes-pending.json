      ],
      "steps": [
        {
          "text": "Макароны отваривать в подсоленной воде на пару минут меньше, чем указано на упаковке.",
          "timeMin": null
        },
        {
          "text": "Зеленый горошек опустить в кипящую воду на 2&ndash;3 минуты, затем, слив воду, поместить на лед.",
          "timeMin": null
        },
        {
          "text": "Пармезан натереть на мелкой терке.",
          "timeMin": null
