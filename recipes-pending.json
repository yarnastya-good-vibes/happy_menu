          "unit": "щепотка"
        }
      ],
      "steps": [
        {
          "text": "Шалот почистить, разрезать на несколько частей и выложить в чашу блендера, добавить творог и все взбить.",
          "timeMin": null
        },
        {
          "text": "К куриному фаршу добавить творог с луком, яйцо, муку, соль, перец и перемешать.",
          "timeMin": null
        },
        {
          "text": "Поддон-противень аэрогриля слегка смазать оливковым маслом, сформировать из фарша небольшие котлеты, выложить на противень, смазать сверху маслом и готовить на режиме &laquo;пар&raquo;.",
          "timeMin": null
        },
        {
          "text": "Вяленые помидоры нарезать кусочками.",
          "timeMin": null
        },
        {
          "text": "Черри разрезать на 4 части.",
          "timeMin": null
        },
        {
          "text": "Брынзу нарезать кубиками.",
          "timeMin": null
        },
        {
          "text": "В глубокий салатник выложить листья салата, нарезанные помидоры и брынзу, полить все уксусом и оливковым маслом, посолить, поперчить, посыпать семечками и перемешать.",
          "timeMin": null
        },
        {
          "text": "Готовые котлеты посыпать копченой паприкой, прованскими травами и сбрызнуть оставшимся оливковым маслом. Подавать котлеты с салатом.",
          "timeMin": null
        }
